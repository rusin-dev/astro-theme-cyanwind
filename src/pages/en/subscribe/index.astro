---
import PageLayout from '@/layouts/CommonPage.astro'
import SubscriptionForm from '@/components/pages/SubscriptionForm.astro'
import config from '@/site-config'

const headings = [
  { depth: 2, slug: 'email-subscribe', text: 'Email Subscription' },
  { depth: 2, slug: 'rss-subscribe', text: 'RSS Subscription' },
  { depth: 2, slug: 'github-subscribe', text: 'GitHub Subscription' }
]
---

<PageLayout title='Subscribe' {headings} info={{ slug: '/subscribe', hideComment: true }}>
  <h2 id='email-subscribe'>Email Subscription<a class='anchor' href='#email-subscribe'>#</a></h2>
  <p>
    Subscribe via email to receive notifications whenever a new article is published, so you never miss an update.
  </p>
  <SubscriptionForm
    heading='Get new articles by email:'
    placeholder='Enter your email address'
    submitLabel='Subscribe'
  />
  <h2 id='rss-subscribe'>RSS Subscription<a class='anchor' href='#rss-subscribe'>#</a></h2>
  <p>
    Stay updated by periodically checking the <a href='rss.xml'>RSS feed</a>.
  </p>
  <h2 id='github-subscribe'>GitHub Subscription<a class='anchor' href='#github-subscribe'>#</a></h2>
  <p>
    Subscribe by starring the GitHub <a href='https://github.com/rusin-dev/astro-theme-cyanwind'>repository</a>. Click the Star button in the top-right corner to receive article updates,
    <b>as well as bug fixes and new feature additions</b>.
  </p>
</PageLayout>

<script
  is:inline
  type='module'
  data-astro-rerun
  define:vars={{ npmCDN: config.npmCDN, walineServer: config.integ.waline.server }}
>
  const normalizePath = (path) => {
    if (path === '/') return path
    return path.endsWith('/') ? path.slice(0, -1) : path
  }

  const loadPageviewCount = async () => {
    const pageview = await import(`${npmCDN}/@waline/client@v3/dist/pageview.js`)
    pageview.pageviewCount({
      serverURL: walineServer,
      path: normalizePath(window.location.pathname)
    })
  }

  await loadPageviewCount()
</script>
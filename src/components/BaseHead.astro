---
// import { ClientRouter } from 'astro:transitions'

import { prod } from '@/utils/server'
import config from '@/site-config'
import globalCss from '@/assets/styles/global.css?inline'

const pathSegments = Astro.url.pathname.split('/').filter(Boolean)
const isEnglish = pathSegments[0] === 'en'

const { articleDate, description, ogImage, title } = Astro.props

// 判断是否为首页（根路径或 /en）
const pathname = Astro.url.pathname
const isHome = pathname === '/' || pathname === '/en' || pathname === '/en/'

// 全局页面标题映射（基于路径）
const PAGE_TITLES: Record<string, { zh: string; en: string }> = {
  '/': { zh: '', en: 'Home' },
  '/article': { zh: '文章', en: 'Articles' },
  '/tags': { zh: '标签', en: 'Tags' },
  '/archives': { zh: '归档', en: 'Archives' },
  '/search': { zh: '搜索', en: 'Search' },
  '/about': { zh: '关于', en: 'About' },
  '/projects': { zh: '项目', en: 'Projects' },
  '/links': { zh: '友链', en: 'Links' },
  '/collection': { zh: '集合', en: 'Collections' },
  '/academic': { zh: '学术', en: 'Academic' },
  '/terms': { zh: '网站政策', en: 'Site Policy' },
  '/terms/privacy-policy': { zh: '隐私政策', en: 'Privacy Policy' },
  '/terms/terms-and-conditions': { zh: '条款与条件', en: 'Terms and Conditions' },
  '/terms/copyright': { zh: '版权声明', en: 'Copyright' },
  '/terms/disclaimer': { zh: '免责声明', en: 'Disclaimer' },
  '/en/article': { zh: '文章', en: 'Articles' },
  '/en/tags': { zh: '标签', en: 'Tags' },
  '/en/archives': { zh: '归档', en: 'Archives' },
  '/en/search': { zh: '搜索', en: 'Search' },
  '/en/about': { zh: '关于', en: 'About' },
  '/en/projects': { zh: '项目', en: 'Projects' },
  '/en/links': { zh: '友链', en: 'Links' },
  '/en/collection': { zh: '集合', en: 'Collections' },
  '/en/academic': { zh: '学术', en: 'Academic' },
  '/en/terms': { zh: '网站政策', en: 'Site Policy' },
  '/en/terms/privacy-policy': { zh: '隐私政策', en: 'Privacy Policy' },
  '/en/terms/terms-and-conditions': { zh: '条款与条件', en: 'Terms and Conditions' },
  '/en/terms/copyright': { zh: '版权声明', en: 'Copyright' },
  '/en/terms/disclaimer': { zh: '免责声明', en: 'Disclaimer' },
}

// 文章分类名映射
const CATEGORY_NAME_MAP: Record<string, string> = {
  'tech': { zh: '技术', en: 'Tech' },
  'life': { zh: '生活', en: 'Life' },
  'solution': { zh: '题解', en: 'Solutions' },
  'ccf': { zh: '信竞', en: 'CCF' },
  'other': { zh: '其他', en: 'Other' },
}

// 动态路径匹配（从最长路径优先匹配）
function resolveTitle(pathname: string): string | undefined {
  // 精确匹配
  const exact = PAGE_TITLES[pathname]
  if (exact) return exact[isEnglish ? 'en' : 'zh']

  // /article/:category 或 /en/article/:category
  const articleCatMatch = pathname.match(/^\/(en\/)?article\/([^/]+)\/?.*$/)
  if (articleCatMatch) {
    const cat = articleCatMatch[2]
    const name = CATEGORY_NAME_MAP[cat]
    if (name) {
      return isEnglish ? `${name.en} Articles` : `${name.zh} 文章`
    }
  }

  // /tags/:tag 或 /en/tags/:tag
  const tagMatch = pathname.match(/^\/(en\/)?tags\/.+$/)
  if (tagMatch) {
    return isEnglish ? 'Tags' : '标签'
  }

  // /collection/:id 或 /en/collection/:id
  const colMatch = pathname.match(/^\/(en\/)?collection\/.+$/)
  if (colMatch) {
    return isEnglish ? 'Collections' : '集合'
  }

  return undefined
}

const resolvedTitle = resolveTitle(pathname)
const displayTitle = resolvedTitle ?? title

// 站点标题也支持中英文切换
const displaySiteTitle = isEnglish ? config.titleEn : config.title

// 生成标题：首页只显示站点名，其他页面显示 "页面标题 | 站点名"
const siteTitle = isHome 
  ? displaySiteTitle 
  : `${displayTitle} ${config.titleDelimiter} ${displaySiteTitle}`

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImageURL = new URL(ogImage ? ogImage : '/images/social-card.webp', Astro.url).href
---

<meta charset='utf-8' />
<meta content='width=device-width, initial-scale=1.0, shrink-to-fit=no' name='viewport' />
<meta content='IE=edge' http-equiv='X-UA-Compatible' />
<title>{siteTitle}</title>

{/* Icons / Favicon */}
<link rel='apple-touch-icon' sizes='180x180' href='/favicon/favicon.ico' />
<link rel='icon' type='image/png' sizes='32x32' href='/favicon/favicon.ico' />
<link rel='icon' type='image/png' sizes='16x16' href='/favicon/favicon.ico' />
<link rel='manifest' href='/favicon/site.webmanifest' />

{/* Font preloads */}
<link rel='preconnect' href='https://cdn.jsdmirror.cn' crossorigin />
<link rel='stylesheet' href='https://cdn.jsdmirror.cn/npm/lxgw-wenkai-webfont@1.7.0/lxgwwenkai-regular.min.css' />
<link rel='stylesheet' href='https://cdn.jsdmirror.cn/npm/lxgw-wenkai-webfont@1.7.0/lxgwwenkai-bold.min.css' />
<link rel='preload' href='/fonts/JetBrainsMono-Regular.woff2' as='font' type='font/woff2' crossorigin />

{/* Canonical URL */}
<link rel='canonical' href={canonicalURL} />

{/* Primary Meta Tags */}
<meta content={siteTitle} name='title' />
<meta content={description} name='description' />
<meta content={config.author} name='author' />

{/* Theme Color */}
<meta content='' name='theme-color' />

{/* Open Graph / Facebook */}
<meta content={articleDate ? 'article' : 'website'} property='og:type' />
<meta content={displayTitle} property='og:title' />
<meta content={description} property='og:description' />
<meta content={canonicalURL} property='og:url' />
<meta content={displaySiteTitle} property='og:site_name' />
{/* 动态设置 og:locale */}
<meta content={isEnglish ? 'en_US' : config.locale.attrs} property='og:locale' />
<meta content={socialImageURL} property='og:image' />
<meta content='1200' property='og:image:width' />
<meta content='630' property='og:image:height' />
{
  articleDate && (
    <>
      <meta content={config.author} property='article:author' />
      <meta content={articleDate} property='article:published_time' />
    </>
  )
}

{/* Twitter */}
<meta content='summary_large_image' property='twitter:card' />
<meta content={canonicalURL} property='twitter:url' />
<meta content={displayTitle} property='twitter:title' />
<meta content={description} property='twitter:description' />
<meta content={socialImageURL} property='twitter:image' />

{/* Sitemap */}
<link href='/sitemap-index.xml' rel='sitemap' />

{/* RSS auto-discovery */}
<link
  rel='alternate'
  type='application/rss+xml'
  title={displaySiteTitle}
  href={`${Astro.site}rss.xml`}
/>

<meta content={Astro.generator} name='generator' />

{/* Styles */}
<style is:inline set:html={globalCss} />

{/* View transitions */}
<!-- <ClientRouter /> -->
<!-- <script is:inline>
  const style = document.createElement('style')
  style.textContent = `* { transition: none !important; }`
  document.addEventListener('astro:after-swap', () => {
    document.head.appendChild(style)
    setTimeout(() => {
      style.remove()
    }, 100)
  })
</script> -->

{
  /* User script*/
  prod && (
    <script>
      console.log( '%c Astro Theme Cyanwind %c https://github.com/rusin-dev/astro-theme-cyanwind',
      'color:#fff;background:linear-gradient(90deg,#448bff,#44e9ff);padding:5px 0;',
      'color:#000;background:linear-gradient(90deg,#44e9ff,#ffffff);padding:5px 10px 5px 0px;' )
    </script>
  )
}